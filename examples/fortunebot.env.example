# Copy this file to ~/.config/fortunebot/fortunebot.env and fill in your secrets.
# Loaded automatically by fortunebot on startup.
# Keep secrets here or in real environment variables — not in config.json.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
FORTUNEBOT_PROMPT=Generate a very short, funny fortune cookie message about AI, programmers, or neural networks. Maximum 2 short sentences.
